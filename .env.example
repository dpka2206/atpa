# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/atpa

# Auth.js
AUTH_SECRET=
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=

# Gmail SMTP (app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ATPA <noreply@example.com>"
ADMIN_NOTIFY_EMAIL=

# Optional public site URL (emails / absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: protect /api/cron/email-queue (Authorization: Bearer …)
CRON_SECRET=
